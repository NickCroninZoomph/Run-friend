# Copy to .env (gitignored) for local emulator use, or set as deployed
# secrets with `firebase functions:secrets:set <NAME>`. Any variable left
# unset puts that integration into mock mode — see src/config.ts.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=

GEMINI_API_KEY=

APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_BUNDLE_ID=com.runfriend.app
